<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup up to Android 11 (data_extraction_rules.xml is used from 12).
    Same content: SharedPreferences and the custom display font, never recordings or caches.
    Preferences hold the caller-ID lookup URL, so they go to the cloud only when the
    backup is end-to-end encrypted.
-->
<full-backup-content>
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <exclude domain="sharedpref" path="dialer_widget.xml" />
    <exclude domain="sharedpref" path="voicemail_transcripts.xml" />
    <include domain="file" path="custom_display_font" />
</full-backup-content>
