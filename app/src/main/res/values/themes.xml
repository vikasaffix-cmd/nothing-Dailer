<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (light, Settings → Theme → Light). Compose draws the screens;
         these only colour the window before Compose starts and the system bars. -->
    <style name="Theme.AllinoneDailer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF111111</item>
        <item name="colorPrimaryVariant">#FF111111</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#FFD71921</item>
        <item name="colorSecondaryVariant">#FFD71921</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="android:windowBackground">#FFF5F5F5</item>
        <item name="android:statusBarColor">#FFF5F5F5</item>
        <item name="android:navigationBarColor">#FFF5F5F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
