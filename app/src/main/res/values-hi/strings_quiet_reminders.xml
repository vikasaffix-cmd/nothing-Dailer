    <string name="quiet_hours_title">शांत समय</string>
    <string name="quiet_hours_help">शांत समय में बाकी कॉल साइलेंट होती हैं, अस्वीकार नहीं: वे मिस्ड कॉल के रूप में दिखती हैं जिन्हें आप वापस कर सकते हैं। आपातकालीन कॉल और आपातकालीन नंबर डायल करने के बाद आने वाली कॉल हमेशा बजती हैं।</string>
    <string name="quiet_hours_needs_android_10">कॉल साइलेंट करने के लिए Android 10 या नया चाहिए। इस फ़ोन पर कॉल बजती रहेंगी।</string>
    <string name="quiet_hours_when">कब</string>
    <string name="quiet_hours_schedule">तय समय पर</string>
    <string name="quiet_hours_follow_dnd">जब भी \'परेशान न करें\' चालू हो</string>
    <string name="quiet_hours_dnd_note">आपके फ़ोन की \'परेशान न करें\' सेटिंग भी लागू रहती है। पसंदीदा और दोबारा कॉल करने वालों को बजने देने के लिए, सिस्टम की \'परेशान न करें\' सेटिंग में भी तारांकित संपर्कों और दोबारा कॉल करने वालों को अनुमति दें।</string>
