<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+): a static mock of widget/DialerWidget.kt at its default size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:text="@string/widget_title"
            android:textAllCaps="true"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_red_dot" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_avatar_background"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_avatar_background"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_avatar_background"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="O"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_avatar_background"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="R"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_missed" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/widget_preview_name_1"
            android:textColor="#FFD71921"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="09:41"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_outgoing" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/widget_preview_name_2"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="08:15"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_incoming" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/widget_preview_name_3"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="07:30"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
